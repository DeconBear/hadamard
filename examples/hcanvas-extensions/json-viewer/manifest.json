{
  "schema": "hcanvas-extension/1",
  "id": "com.hadamard.examples.json",
  "name": "JSON Viewer",
  "version": "0.1.0",
  "description": "Read-only formatted JSON viewer.",
  "engines": {
    "hcanvas": ">=0.2.0"
  },
  "capabilities": {},
  "contributes": {
    "formats": [
      {
        "id": "json",
        "label": "JSON",
        "extensions": [
          ".json"
        ],
        "viewer": "json.viewer",
        "surfaces": [
          "file"
        ]
      }
    ],
    "viewers": [
      {
        "id": "json.viewer",
        "label": "JSON Viewer",
        "type": "iframe",
        "entry": "ui/entry.html",
        "surfaces": [
          "file"
        ]
      }
    ]
  }
}
