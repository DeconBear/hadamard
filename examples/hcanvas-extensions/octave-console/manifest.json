{
  "schema": "hcanvas-extension/1",
  "id": "com.hadamard.examples.octave",
  "name": "GNU Octave Console",
  "version": "0.1.0",
  "description": "Run GNU Octave snippets and capture text/plot output through a sidecar.",
  "engines": {
    "hcanvas": ">=0.3.0"
  },
  "capabilities": {
    "document": {
      "read": true
    },
    "process": {
      "sidecars": [
        "octave-runner"
      ],
      "tools": []
    }
  },
  "contributes": {
    "viewers": [
      {
        "id": "octave.viewer",
        "label": "Octave Console",
        "type": "iframe",
        "entry": "ui/entry.html",
        "surfaces": [
          "tab"
        ]
      }
    ],
    "views": [
      {
        "id": "octave.console",
        "title": "Octave Console",
        "slot": "workspace-tab",
        "viewer": "octave.viewer"
      }
    ],
    "commands": [
      {
        "id": "octave.open",
        "title": "Octave: Open console",
        "category": "Octave",
        "exec": {
          "kind": "view",
          "viewId": "octave.console"
        }
      }
    ],
    "sidecars": [
      {
        "id": "octave-runner",
        "label": "Octave runner",
        "command": [
          "node",
          "sidecar/octave_runner.mjs"
        ],
        "cwd": "extension",
        "role": "service",
        "protocol": "jsonrpc-stdio",
        "requests": [
          {
            "method": "run",
            "timeoutMs": 120000
          }
        ],
        "outputChannel": "Octave",
        "limits": {
          "maxStdoutBytes": 4194304,
          "maxStderrBytes": 1048576,
          "maxArtifactBytes": 8388608
        }
      }
    ]
  }
}
